{
  "name": "@zof-ai/change-impact",
  "version": "0.1.0",
  "description": "Explainable offline static change-impact analysis for JavaScript, TypeScript and Python",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zof-change-impact": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "examples",
    "docs",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "@zof-ai/evidence-spec": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zof-AI/zof-change-impact.git"
  },
  "homepage": "https://github.com/Zof-AI/zof-change-impact#readme",
  "bugs": {
    "url": "https://github.com/Zof-AI/zof-change-impact/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "change-impact",
    "static-analysis",
    "typescript",
    "python",
    "testing"
  ]
}
